# Never place a real key in source code or commit it to version control.
# Primary odds and existing MLB/NFL source.
THE_ODDS_API_KEY=
THERUNDOWN_API_KEY=

# Multi-sport backup odds and enrichment services. These are wired for protected
# connection checks; backup odds remain observation-only until normalization is certified.
ODDSPAPI_API_KEY=
ODDS_API_IO_KEY=
SPORTSGAMEODDS_API_KEY=
API_SPORTS_KEY=
CFBD_API_KEY=
FOOTBALL_DATA_API_KEY=

# Comma-separated provider keys. Leave blank until we approve both lists.
MARKET_CONSENSUS_BOOKMAKERS=
ACCESSIBLE_BOOKMAKERS=

# Research publishing never takes real-money actions.
BOT_MODE=research
PAPER_UNIT_DOLLARS=5

# Maximum age of an odds quote at decision time.
ODDS_STALE_AFTER_MINUTES=60

# Monthly quota protection. Unused daily credits roll forward, and the sustainable
# daily allowance automatically shrinks if the remaining balance falls behind pace.
ODDS_API_MIN_REMAINING_CREDITS=50
ODDS_API_DAILY_CREDIT_CAP=10
MULTISPORT_ODDS_HORIZON_MINUTES=90
MULTISPORT_ODDS_REFRESH_MINUTES=30
MULTISPORT_SCORE_POLL_MINUTES=720
MULTISPORT_MMA_RESULT_POLL_MINUTES=360
MULTISPORT_PARTICIPANT_REFRESH_HOURS=24

# Automatic historical collection uses the free Odds-API.io settled-events endpoint.
# Closing odds are optional and remain bounded to the listed provider bookmaker names.
MULTISPORT_HISTORY_LOOKBACK_DAYS=3
MULTISPORT_HISTORY_MAX_REQUESTS=30
MULTISPORT_HISTORY_MAX_LEAGUES_PER_SPORT=5
MULTISPORT_HISTORY_MAX_ODDS_EVENTS=10
ODDS_API_IO_HISTORY_BOOKMAKERS=

# Automatic live research intake. Map approved source keys to authenticated HTTPS
# adapter feeds that return event-specific normalized observations. Official-source
# feeds require the bearer token. The 30-request ceiling is intentionally conservative.
MULTISPORT_RESEARCH_FEEDS_JSON=
MULTISPORT_RESEARCH_FEED_TOKEN=
MULTISPORT_RESEARCH_MAX_REQUESTS=30
MULTISPORT_RESEARCH_HORIZON_MINUTES=360

# Safe network limits for every collector.
HTTP_TIMEOUT_SECONDS=20
HTTP_RETRY_ATTEMPTS=3

# SQLite database created by scripts/init_db.py or an operations workflow.
DATABASE_PATH=var/sports_analytics.sqlite3

# Required identifying contact for future National Weather Service requests.
NWS_USER_AGENT=


# Isolated NHL/CFB adapter keys. Existing provider keys remain separate.
NHL_CFB_ODDS_API_KEY=
# Secondary CollegeFootballData key.
CFBD_2_API_KEY=

# Optional primary bookmaker profile key (provider bookmaker key).
PRIMARY_BOOKMAKER_KEY=

# Telegram notifications (optional).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_EXPECTED_USERNAME=
